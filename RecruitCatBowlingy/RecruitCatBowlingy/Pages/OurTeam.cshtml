@page
@model RecruitCatBowlingy.Pages.OurTeamModel
@{
    ViewData["Title"] = "Our Team";
}

<h1 class="text-center section-header">Meet the Team</h1>

<div id="team-card-container">
    <div class="card mb-3 text-bg-dark">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="/images/greg.jpg" class="img-fluid rounded-start" alt="Greg Bowling wearing a gray jacket with a cat laying across his shoulder and back.">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">Greg Bowling</h5>
                    <p class="card-text role"><small>CEO and Lead Cat Wrangler</small></p>
                    <p class="card-text">
                        Greg leads the company's strategy and vision. People thought he was crazy when he started this company. Now it's one of the most profitable in the world.
                        Working with cats has it's challenges, but he couldn't imagine having more purrfect coworkers.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3 text-bg-primary">
        <div class="row g-0 flex-column-reverse flex-md-row">
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">Kona</h5>
                    <p class="card-text role"><small>Executive Director and Wellness Specialist</small></p>
                    <p class="card-text">
                        Kona believes that personal wellness is the key to a joyful and fulfilling life. She has spent her life studying and practicing the arts of
                        accupuncture, yoga, and cuddling. Her calling is to help others find the best version of themselves.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <img src="/images/kona.jpg" class="img-fluid rounded-end" alt="A tabby cat laying on a hardwood floor with a purple ribbon loosely wrapped around it.">
            </div>
        </div>
    </div>

    <div class="card mb-3 text-bg-success">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="/images/rory.jpg" class="img-fluid rounded-start" alt="A gray cat looking out a window in a dark room with its face illuminated by light from outside the window.">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h5 class="card-title">Rory</h5>
                    <p class="card-text role"><small>Landscaping and Biscuit Making Coordinator</small></p>
                    <p class="card-text">
                        Rory does a little bit of everything. She can trim your hedges, replace your outlets, install shelving, and teach you to cook.
                        But the thing she enjoys the most is making the very best biscuits in the world.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>