@page
@model RecruitCatBowlingy.Pages.CompanyPages.DetailsModel

@{
    ViewData["Title"] = "Company Details";
}

<h1>Company Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.PositionRecruiting)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.PositionRecruiting)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.MinimumSalary)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.MinimumSalary)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.MaximumSalary)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.MaximumSalary)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.StartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.StartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.Location)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.Location)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.NumberOfEmployees)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.NumberOfEmployees)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.YearFounded)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.YearFounded)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Company.Industry.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Company.Industry.Name)
        </dd>
    </dl>
</div>

@if (Model.Company.Candidates.Any())
{
    <div>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Company.Candidates[0].FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.Company.Candidates[0].TargetSalary)</th>
                    <th>@Html.DisplayNameFor(model => model.Company.Candidates[0].Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Company.Candidates[0].LevelOfEducation)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Company.Candidates)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                        <td>@Html.DisplayFor(modelItem => item.TargetSalary)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@Html.DisplayFor(modelItem => item.LevelOfEducation)</td>
                        <td>
                            <a asp-page="/Candidates/Details" asp-route-id="@item.Id">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">No Candidates Exist for this Company.</div>
}

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Company.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
