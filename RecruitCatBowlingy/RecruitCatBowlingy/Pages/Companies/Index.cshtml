@page
@model RecruitCatBowlingy.Pages.CompanyPages.IndexModel

@{
    ViewData["Title"] = "Companies";
}

<h1>Companies</h1>

<p>
    <a asp-page="Create">Create New Company</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].PositionRecruiting)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].YearFounded)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company[0].Industry.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Company) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.PositionRecruiting)
            </td>
            <td>
                @Html.DisplayFor(model => item.YearFounded)
            </td>
            <td>
                @Html.DisplayFor(model => item.Industry.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>